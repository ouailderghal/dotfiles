#!/bin/sh
#
# i3blocks block: first device of the given nmcli TYPE and its IP, mirroring
# the old i3status "_first_" wireless/ethernet modules.
#
# Usage: network <nmcli-type> <label-prefix>

type=$1
prefix=$2

dev=$(nmcli -t -f DEVICE,TYPE device status | awk -F: -v t="$type" '$2==t{print $1; exit}')

if [ -z "$dev" ]; then
	echo "$prefix: down"
	exit 0
fi

ip=$(nmcli -g IP4.ADDRESS device show "$dev" 2>/dev/null | cut -d/ -f1)

if [ -n "$ip" ]; then
	echo "$prefix: UP ($ip)"
else
	echo "$prefix: down"
fi
